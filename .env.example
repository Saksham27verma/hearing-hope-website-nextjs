NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Pinnacle / Pinbot WhatsApp (never NEXT_PUBLIC_)
PINNACLE_PHONE_ID=
PINNACLE_API_KEY=
PINNACLE_TEMPLATE_LANGUAGE=en
PINNACLE_FORM_TEMPLATE_NAME=hh_test_appt_received
PINNACLE_LEAD_NOTIFY_TEMPLATE_NAME=hh_site_booking_alert
PINNACLE_WABA_NUMBER=917428711680

# Instant clinic notifications
LEAD_NOTIFY_EMAIL=
LEAD_NOTIFY_WHATSAPP=7428711680
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Server-only. Internal SEO automation API. Never expose this to the browser.
INTERNAL_API_TOKEN=
# Supabase service role. Used by the internal API and later jobs. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# SEO automation: generation. Gemini 3.8 Flash is a free-tier Flash model as of September 2026.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_PROVIDER=gemini
LLM_DAILY_REQUEST_CAP=40
LLM_MIN_INTERVAL_SECONDS=10
AUTOMATION_ENABLED=true
# Writes tickets and drafts while suppressing notification delivery; use for a safe rehearsal.
AUTOMATION_DRY_RUN=false
LLM_FALLBACK_PROVIDER=
GROQ_API_KEY=
# Optional Groq free-tier fallback model. Leave blank unless LLM_FALLBACK_PROVIDER=groq.
GROQ_MODEL=

# SEO automation: protected internal endpoints and public-site identity.
CRON_SECRET=
REVALIDATE_SECRET=
SITE_URL=
SITE_DOMAIN=
INDEXNOW_KEY=

# SEO automation: Google Search Console uses a service-account JSON document.
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=

# SEO automation: Google Business Profile uses OAuth refresh-token credentials.
GBP_OAUTH_CLIENT_ID=
GBP_OAUTH_CLIENT_SECRET=
GBP_REFRESH_TOKEN=

# SEO automation: free external signal and notification integrations.
PSI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=
OWNER_EMAIL=
ESCALATION_EMAIL=
DEV_ALERT_EMAIL=
COMPETITOR_DOMAINS=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SLACK_WEBHOOK_URL=

# SEO automation: optional email provider for digests and escalation emails.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
